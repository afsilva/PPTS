# Non-secret template only. `make start` copies this outside the repository with
# mode 0600 and generates all values. Never commit real credentials.
POSTGRES_PASSWORD=replace-with-a-random-local-password
KEYCLOAK_DB_PASSWORD=replace-with-a-random-local-password
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-random-local-password
KEYCLOAK_ALEX_PASSWORD=replace-with-a-random-local-password
KEYCLOAK_CASEY_PASSWORD=replace-with-a-random-local-password
KEYCLOAK_MORGAN_PASSWORD=replace-with-a-random-local-password
SESSION_SECRET=replace-with-a-random-base64url-secret-at-least-43-characters
PPTS_PORT=3000
KEYCLOAK_PORT=8080
# IANA zone used for report month boundaries and labels.
ORGANIZATION_TIME_ZONE=UTC
MAINTENANCE_INTERVAL_SECONDS=86400
# Local document policy. Production values require owner approval.
DOCUMENT_MAX_BYTES=5242880
DOCUMENT_PROJECT_MAX_BYTES=104857600
DOCUMENT_PROJECT_MAX_COUNT=500
DOCUMENT_RETENTION_DAYS=0
