generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMINISTRATOR
  AUDITOR
}

enum PresenceState {
  OFF_DUTY
  AVAILABLE
  WORKING
}

enum ProjectRole {
  CONTRIBUTOR
  MANAGER
}

enum PersonKind {
  EMPLOYEE
  CONTACT
}

enum DocumentStatus {
  AVAILABLE
  REJECTED
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  issuer      String
  subject     String
  username    String
  displayName String
  email       String
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  roles       UserRole[]
  memberships ProjectMember[]
  presence    Presence?
  timeEntries TimeEntry[]
  person      Person?
  projectLogs ProjectLog[]
  documents   ProjectDocument[]
  auditEvents AuditEvent[] @relation("AuditActor")
  sessions    Session[]

  @@unique([issuer, subject])
  @@index([active])
}

model UserRole {
  userId String @db.Uuid
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
}

model Session {
  idHash     String    @id @db.Char(64)
  userId     String    @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  idTokenHash   String @db.Char(64)
  idTokenCipher String @db.Text
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Person {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String?    @unique @db.Uuid
  kind          PersonKind @default(EMPLOYEE)
  displayName   String     @db.VarChar(160)
  createdById   String?    @db.Uuid
  submissionId String?    @db.Uuid
  title         String     @default("") @db.VarChar(120)
  address       String     @default("") @db.VarChar(500)
  workPhone     String     @default("") @db.VarChar(40)
  homePhone     String     @default("") @db.VarChar(40)
  mobilePhone   String     @default("") @db.VarChar(40)
  legacyIm      String     @default("") @db.VarChar(80)
  birthdayMonth Int?
  birthdayDay   Int?
  archivedAt    DateTime?  @db.Timestamptz(3)
  version       Int        @default(1)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  managedProjects     Project[] @relation("ProjectCoder")
  developmentProjects Project[] @relation("ProjectDevelopmentContact")
  productionProjects  Project[] @relation("ProjectProductionContact")

  @@unique([createdById, submissionId])
  @@index([kind, displayName])
  @@index([archivedAt])
}

model Client {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @unique
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  version    Int       @default(1)
  projects   Project[]
}

model ProjectStatus {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String    @default("")
  version     Int       @default(1)
  projects    Project[]
}

model Project {
  id               String          @id @default(uuid()) @db.Uuid
  clientId         String          @db.Uuid
  statusId         String          @db.Uuid
  name             String
  description      String          @default("")
  billingRateCents Int?
  version          Int             @default(1)
  languages        String          @default("") @db.VarChar(500)
  modules          String          @default("") @db.VarChar(500)
  extras           String          @default("") @db.VarChar(1000)
  developmentServerName String      @default("") @db.VarChar(255)
  developmentServerPath String      @default("") @db.VarChar(500)
  productionServerName  String      @default("") @db.VarChar(255)
  productionServerPath  String      @default("") @db.VarChar(500)
  estimatedDesignMinutes      Int?
  estimatedCodingMinutes      Int?
  estimatedManagementMinutes  Int?
  estimatedTestingMinutes     Int?
  estimatedMaintenanceMinutes Int?
  coderId              String?         @db.Uuid
  developmentContactId String?         @db.Uuid
  productionContactId  String?         @db.Uuid
  archivedAt       DateTime?       @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
  client           Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status           ProjectStatus   @relation(fields: [statusId], references: [id], onDelete: Restrict)
  coder             Person?        @relation("ProjectCoder", fields: [coderId], references: [id], onDelete: SetNull)
  developmentContact Person?       @relation("ProjectDevelopmentContact", fields: [developmentContactId], references: [id], onDelete: SetNull)
  productionContact Person?        @relation("ProjectProductionContact", fields: [productionContactId], references: [id], onDelete: SetNull)
  members          ProjectMember[]
  presence         Presence[]
  timeEntries      TimeEntry[]
  logs             ProjectLog[]
  documents        ProjectDocument[]

  @@unique([clientId, name])
  @@index([statusId])
  @@index([coderId])
  @@index([developmentContactId])
  @@index([productionContactId])
}

model ProjectMember {
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole @default(CONTRIBUTOR)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model WorkCode {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  description String      @default("")
  active      Boolean     @default(true)
  version     Int         @default(1)
  timeEntries TimeEntry[]
}

model Presence {
  userId    String        @id @db.Uuid
  state     PresenceState @default(OFF_DUTY)
  projectId String?       @db.Uuid
  message   String        @default("") @db.VarChar(280)
  version   Int           @default(1)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([state])
  @@index([projectId])
}

model TimeEntry {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  projectId  String    @db.Uuid
  workCodeId String    @db.Uuid
  startedAt  DateTime  @db.Timestamptz(3)
  endedAt    DateTime? @db.Timestamptz(3)
  note       String    @default("") @db.VarChar(2000)
  version    Int       @default(1)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  workCode   WorkCode  @relation(fields: [workCodeId], references: [id], onDelete: Restrict)

  @@index([userId, startedAt])
  @@index([projectId, startedAt])
}

model ProjectLog {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  authorId  String   @db.Uuid
  body      String   @db.VarChar(5000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
}

model ProjectDocument {
  id           String         @id @default(uuid()) @db.Uuid
  projectId    String         @db.Uuid
  uploadedById String         @db.Uuid
  objectKey    String         @unique @db.VarChar(255)
  originalName String         @db.VarChar(255)
  mediaType    String         @db.VarChar(100)
  sizeBytes    Int
  sha256       String         @db.Char(64)
  status       DocumentStatus @default(AVAILABLE)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  uploadedBy   User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  occurredAt   DateTime @default(now()) @db.Timestamptz(3)
  actorId      String?  @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @db.VarChar(100)
  resourceId   String?  @db.VarChar(100)
  outcome      String   @db.VarChar(30)
  requestId    String?  @db.VarChar(100)
  metadata     Json     @default("{}")
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([action, occurredAt])
}
