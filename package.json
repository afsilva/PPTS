{
  "name": "ppts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A secure, modern people and project tracking system.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node --conditions react-server --import ./tests/setup/node-exports-shim.mjs --test tests/unit/*.test.ts",
    "test:contract": "node scripts/check-regression-contract.mjs",
    "test:integration": "node --conditions react-server --import ./tests/setup/node-exports-shim.mjs --test --test-concurrency=1 tests/integration/*.test.ts",
    "verify": "npm run supply-chain && npm run deprecations && npm run audit && npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:contract && npm run build",
    "supply-chain": "node scripts/check-npm-supply-chain.mjs",
    "audit": "npm audit --audit-level=low",
    "deprecations": "node scripts/verify-dependency-metadata.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "jose": "6.2.15",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "server-only": "0.0.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "@babel/core": "7.29.7",
    "@babel/generator": "7.29.12",
    "@babel/helper-compilation-targets": "7.29.7",
    "@babel/helper-module-transforms": "7.29.7",
    "@babel/helper-string-parser": "7.29.11",
    "@babel/helpers": "7.29.10",
    "@babel/parser": "7.29.12",
    "@babel/traverse": "7.29.12",
    "caniuse-lite": "1.0.30001820",
    "electron-to-chromium": "1.5.476",
    "@isaacs/nonrecursive-glob-match": "1.0.3"
  }
}
